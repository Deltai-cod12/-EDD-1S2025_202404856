  end
  object txtCorreo: TEdit
    Left = 150
    Top = 165
    Width = 200
    Height = 25
  end
  object btnAgregar: TButton
    Left = 150
    Top = 200
    Width = 100
    Height = 30
    Caption = 'Agregar'
    OnClick = btnAgregarClick
  end
  object btnCerrar: TButton
    Left = 150
    Top = 240
    Width = 100
    Height = 30
    Caption = 'Cerrar'
    OnClick = btnCerrarClick
  end
end

