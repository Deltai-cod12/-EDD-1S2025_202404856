  end
  object lblComunidad: TLabel
    Left = 20
    Top = 130
    Width = 100
    Height = 20
    Caption = 'Comunidad:'
  end
  object txtComunidad: TEdit
    Left = 150
    Top = 130
    Width = 200
    Height = 25
  end
  object lblCorreo: TLabel
    Left = 20
    Top = 165
    Width = 100
    Height = 20
