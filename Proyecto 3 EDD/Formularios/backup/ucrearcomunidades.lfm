  object lblTitulo: TLabel
    Left = 130
    Top = 10
    Width = 150
    Height = 25
    Caption = 'COMUNIDADES'
    Font.Size = 14
    Font.Style = [fsBold]
  end
  object lblNombre: TLabel
    Left = 20
    Top = 50
