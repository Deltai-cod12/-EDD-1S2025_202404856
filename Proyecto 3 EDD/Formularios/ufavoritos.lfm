object frmFavoritos: TfrmFavoritos
  Left = 0
  Top = 0
  Width = 600
  Height = 400
  Caption = 'Favoritos'
  OnShow = FormShow

  object lblTotal: TLabel
    Left = 16
    Top = 8
    Width = 200
    Height = 25
    Caption = 'Total favoritos: 0'
  end

  object gridFavoritos: TStringGrid
    Left = 16
    Top = 40
    Width = 560
    Height = 150
    ColCount = 3
    RowCount = 1
    FixedCols = 0
    FixedRows = 1
    Options = [goFixedVertLine, goFixedHorzLine, goVertLine, goHorzLine, goRowSelect]
    OnSelectCell = gridFavoritosSelectCell
  end

  object lblDetalle: TLabel
    Left = 16
    Top = 200
    Width = 100
    Height = 25
    Caption = 'Detalles del correo:'
  end

  object lblRemitente: TLabel
    Left = 16
    Top = 230
    Width = 200
    Height = 20
    Caption = 'Remitente:'
  end

  object lblAsunto: TLabel
    Left = 16
    Top = 260
    Width = 200
    Height = 20
    Caption = 'Asunto:'
  end

  object lblFecha: TLabel
    Left = 16
    Top = 290
    Width = 200
    Height = 20
    Caption = 'Fecha:'
  end

  object memoMensaje: TMemo
    Left = 220
    Top = 230
    Width = 356
    Height = 120
    ReadOnly = True
  end

  object btnEliminar: TButton
    Left = 480
    Top = 360
    Width = 100
    Height = 30
    Caption = 'Eliminar'
    OnClick = btnEliminarClick
  end

  object btnReporte: TButton
  Left = 400
  Top = 320
  Width = 150
  Height = 30
  Caption = 'Generar Reporte'
  OnClick = btnReporteClick
end
end

