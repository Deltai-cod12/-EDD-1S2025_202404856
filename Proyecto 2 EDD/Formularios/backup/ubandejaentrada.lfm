  object lvCorreos: TListView
    Left = 16
    Top = 16
    Width = 560
    Height = 200
    ViewStyle = vsReport
    OnSelectItem = lvCorreosSelectItem
    Columns = <
      column
        Caption = 'Estado'
        Width = 60
      end
      column
